{
  "name": "humaniza-numeros",
  "version": "1.0.1",
  "description": "Transforma números grandes (12345678) em versões mais legíveis (12,3 Milhões).",
  "main": "./dist/index.cjs",
  "files": [
    "./dist/"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --experimental-test-coverage test/humaniza.Test.js test/modules.test.js",
    "test:package": "node scripts/test-package.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test && npm run test:package",
    "prepare": "husky",
    "prepack": "npm run build",
    "semantic-release": "semantic-release"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/robertofrega/humaniza-numeros.git"
  },
  "keywords": [
    "number",
    "portuguese",
    "pt-br"
  ],
  "author": "https://github.com/betofrega",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/betofrega/humaniza-numeros/issues"
  },
  "homepage": "https://github.com/betofrega/humaniza-numeros#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.14.0 || >=24.10.0"
  }
}
